{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved file-level exclusions, never feature acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_sha", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "reference_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blob_sha", "reason_code", "adaptation_wp", "review_basis", "android_adaptation"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "reason_code": {"type": "string", "enum": ["removed-billing", "removed-translation", "generated-swift", "apple-only-glue"]},
          "adaptation_wp": {"type": "string", "pattern": "^WP-[0-9]{3}$"},
          "review_basis": {"type": "string", "minLength": 1},
          "android_adaptation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
