<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidOnly: WP-002 Respect system dark appearance at launcher creation. -->
<resources>
    <style name="Theme.MeshCoreOne" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#101318</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#101318</item>
    </style>
</resources>
