/*
  WhatsNew.strings
  MC1

  Strings for the "What's New" sheet shown once after a major update.
  Update these every major release: edit the per-feature title/description
  pairs (add or remove a block) and keep WhatsNewCatalog.swift in sync.
*/

/* Title of the What's New sheet shown once after an app update */
"whatsNew.title" = "What's New";

/* Button to dismiss the What's New sheet */
"whatsNew.continueButton" = "Continue";

/* Link on the What's New sheet to the full GitHub release notes */
"whatsNew.fullReleaseNotes" = "See all new changes";

/* What's New v1.5 - Path Details feature, title */
"whatsNew.pathDetails.title" = "Path Details";
/* What's New v1.5 - Path Details feature, description */
"whatsNew.pathDetails.description" = "Path Map has moved into Path Details, which lists every extra incoming path. And Repeat Details on sent messages lists every repeat path your radio heard.";

/* What's New v1.5 - Tap a reaction to see who added it, title */
"whatsNew.whoReacted.title" = "Who reacted";
/* What's New v1.5 - Tap a reaction to see who added it, description */
"whatsNew.whoReacted.description" = "Tap a reaction on a message to see who added it, instead of sending the reaction.";

/* What's New v1.5 - Faster chat loading, title */
"whatsNew.fasterChatLoading.title" = "Faster chat loading";
/* What's New v1.5 - Faster chat loading, description */
"whatsNew.fasterChatLoading.description" = "Opening a chat is up to 90%% faster.";

/* What's New v1.6 - Pinned chats, title */
"whatsNew.pinnedChats.title" = "Pinned chats";
/* What's New v1.6 - Pinned chats, description */
"whatsNew.pinnedChats.description" = "Pinned chats are now separate from favorites. Pinned chats appear in a Pinned section, and contacts you had already favorited are pinned the first time you open the app.";

/* What's New v1.6 - Read and unread, title */
"whatsNew.readAndUnread.title" = "Read and unread";
/* What's New v1.6 - Read and unread, description */
"whatsNew.readAndUnread.description" = "Mark a conversation as read or unread by long pressing on the chat.";

/* What's New v1.6 - iPhone Duo, title */
"whatsNew.iPhoneDuo.title" = "iPhone Duo";
/* What's New v1.6 - iPhone Duo, description */
"whatsNew.iPhoneDuo.description" = "MC1 is ready for iPhone Duo with resizable layouts.";

/* What's New v1.6 - iPad tab bar, title */
"whatsNew.iPadTabBar.title" = "iPad tab bar";
/* What's New v1.6 - iPad tab bar, description */
"whatsNew.iPadTabBar.description" = "iPad is moving the tab icons from the left to the top. This helps us better support all devices including the iPhone Duo.";

/* What's New v1.6 - Advanced map filters, title */
"whatsNew.advancedMapFilters.title" = "Advanced map filters";
/* What's New v1.6 - Advanced map filters, description */
"whatsNew.advancedMapFilters.description" = "Filter the map by last heard time and hop count. You can pick a preset or set a custom range, and remove a filter from its chip.";

/* What's New v1.6 - Bluetooth and Wi-Fi, title */
"whatsNew.bluetoothAndWiFi.title" = "Bluetooth and Wi-Fi";
/* What's New v1.6 - Bluetooth and Wi-Fi, description */
"whatsNew.bluetoothAndWiFi.description" = "If a radio is on firmware 1.18 or later and paired over both Bluetooth and Wi-Fi, you can switch between them in Connect Device and in Settings > Connection.";

/* What's New v1.6 - More changes, title */
"whatsNew.moreChanges.title" = "More changes";
/* What's New v1.6 - More changes, description */
"whatsNew.moreChanges.description" = "Tap \"See all new changes\" below to view the full list of bug fixes and other features.";

/* What's New v1.7 - Direct messages, title */
"whatsNew.directMessages.title" = "Direct messages";
/* What's New v1.7 - Direct messages, description */
"whatsNew.directMessages.description" = "Direct messages now try the path 4 times, then flood 4 times. Change Attempts on Path, Flood Attempts, and Fall Back to Flood in Advanced Settings.";

/* What's New v1.7 - Blocks and filters, title */
"whatsNew.blocksAndFilters.title" = "Blocks & Filters";
/* What's New v1.7 - Blocks and filters, description */
"whatsNew.blocksAndFilters.description" = "Hide messages that match a word or phrase. A rule can look at the message, the sender's name, or both, and you choose which chats it applies to. Hidden messages can be seen in Recently Blocked under Settings > Blocks & Filters.";

/* What's New v1.7 - Node telemetry, title */
"whatsNew.nodeTelemetry.title" = "Node telemetry";
/* What's New v1.7 - Node telemetry, description */
"whatsNew.nodeTelemetry.description" = "Settings > Device Info shows telemetry from the node you are connected to.";

/* What's New v1.7 - Live Activity, title */
"whatsNew.liveActivity.title" = "Live Activity";
/* What's New v1.7 - Live Activity, description */
"whatsNew.liveActivity.description" = "Unread messages are more prominent and the packets per minute rate is easier to understand.";
