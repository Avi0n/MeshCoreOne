/* What's New v1.5 - Path Details feature, title */
"whatsNew.pathDetails.title" = "Path Details";
/* What's New v1.5 - Path Details feature, description */
"whatsNew.pathDetails.description" = "Path Map has moved into Path Details, which lists every extra incoming path. And Repeat Details on sent messages lists every repeat path your radio heard.";

/* What's New v1.5 - Tap a reaction to see who added it, title */
