/*
  WhatsNew.strings
  MC1

  Italian translation of What's New sheet strings.
  Match Settings/Maps terminology for this verified locale.
  New release blocks still need native speaker check when added.
*/

/* Title of the What's New sheet shown once after an app update */
"whatsNew.title" = "Novità";

/* Button to dismiss the What's New sheet */
"whatsNew.continueButton" = "Continua";

/* Link on the What's New sheet to the full GitHub release notes */
"whatsNew.fullReleaseNotes" = "Vedi tutte le nuove modifiche";

/* What's New v1.5 - Path Details feature, title */
"whatsNew.pathDetails.title" = "Dettagli percorso";
/* What's New v1.5 - Path Details feature, description */
"whatsNew.pathDetails.description" = "La Mappa del percorso è stata spostata in Dettagli percorso, che elenca ogni percorso extra in arrivo. Dettagli ripetizioni sui messaggi inviati elenca ogni percorso di ripetizione che la radio ha ricevuto.";

/* What's New v1.5 - Tap a reaction to see who added it, title */
"whatsNew.whoReacted.title" = "Chi ha reagito";
/* What's New v1.5 - Tap a reaction to see who added it, description */
"whatsNew.whoReacted.description" = "Tocca una reazione su un messaggio per vedere chi ha reagito, invece di inviare la reazione.";

/* What's New v1.5 - Faster chat loading, title */
"whatsNew.fasterChatLoading.title" = "Caricamento chat più veloce";
/* What's New v1.5 - Faster chat loading, description */
"whatsNew.fasterChatLoading.description" = "Aprire una chat è fino al 90%% più veloce.";

/* What's New v1.6 - Pinned chats, title */
"whatsNew.pinnedChats.title" = "Chat fissate";
/* What's New v1.6 - Pinned chats, description */
"whatsNew.pinnedChats.description" = "Le chat fissate sono ora separate dai preferiti. Le chat fissate compaiono nella sezione Fissato e i contatti che avevi già aggiunto ai preferiti vengono fissati la prima volta che apri l'app.";

/* What's New v1.6 - Read and unread, title */
"whatsNew.readAndUnread.title" = "Letti e non letti";
/* What's New v1.6 - Read and unread, description */
"whatsNew.readAndUnread.description" = "Tieni premuto sulla chat per segnare la conversazione come letta o non letta.";

/* What's New v1.6 - iPhone Duo, title */
"whatsNew.iPhoneDuo.title" = "iPhone Duo";
/* What's New v1.6 - iPhone Duo, description */
"whatsNew.iPhoneDuo.description" = "MC1 è pronto per iPhone Duo con layout ridimensionabili.";

/* What's New v1.6 - iPad tab bar, title */
"whatsNew.iPadTabBar.title" = "Barra dei pannelli su iPad";
/* What's New v1.6 - iPad tab bar, description */
"whatsNew.iPadTabBar.description" = "iPad sposta le icone dei pannelli dal lato sinistro alla parte superiore. Questo ci aiuta a supportare meglio tutti i dispositivi, incluso iPhone Duo.";

/* What's New v1.6 - Advanced map filters, title */
"whatsNew.advancedMapFilters.title" = "Filtri avanzati della mappa";
/* What's New v1.6 - Advanced map filters, description */
"whatsNew.advancedMapFilters.description" = "Filtra la mappa per Ultimo ascolto e numero di salti. Puoi scegliere un preset o impostare un intervallo personalizzato, e rimuovere un filtro.";

/* What's New v1.6 - Bluetooth and Wi-Fi, title */
"whatsNew.bluetoothAndWiFi.title" = "Bluetooth e Wi‑Fi";
/* What's New v1.6 - Bluetooth and Wi-Fi, description */
"whatsNew.bluetoothAndWiFi.description" = "Se una radio ha il firmware 1.18 o successivo ed è associata sia tramite Bluetooth sia tramite Wi‑Fi, puoi passare dall'uno all'altro in Connetti dispositivo e in Impostazioni > Connessione.";

/* What's New v1.6 - More changes, title */
"whatsNew.moreChanges.title" = "Altre modifiche";
/* What's New v1.6 - More changes, description */
"whatsNew.moreChanges.description" = "Tocca \"Vedi tutte le nuove modifiche\" qui sotto per vedere l'elenco completo delle correzioni di bug e delle altre funzionalità.";

/* What's New v1.7 - Direct messages, title */
"whatsNew.directMessages.title" = "Messaggi diretti";
/* What's New v1.7 - Direct messages, description */
"whatsNew.directMessages.description" = "I messaggi diretti ora provano il percorso 4 volte, poi 4 volte con routing flood. Cambia Tentativi sul percorso, Tentativi con routing flood e Ripiego sul routing flood in Impostazioni avanzate.";

/* What's New v1.7 - Blocks and filters, title */
"whatsNew.blocksAndFilters.title" = "Blocco e filtri";
/* What's New v1.7 - Blocks and filters, description */
"whatsNew.blocksAndFilters.description" = "Nascondi i messaggi che corrispondono a una parola o una frase. Una regola può cercare nel messaggio, nel nome del mittente o in entrambi, e scegli a quali chat si applica. I messaggi nascosti si vedono in Bloccati di recente in Impostazioni > Blocco e filtri.";

/* What's New v1.7 - Node telemetry, title */
"whatsNew.nodeTelemetry.title" = "Telemetria del nodo";
/* What's New v1.7 - Node telemetry, description */
"whatsNew.nodeTelemetry.description" = "Impostazioni > Info dispositivo mostra la telemetria del nodo a cui sei connesso.";

/* What's New v1.7 - Live Activity, title */
"whatsNew.liveActivity.title" = "Attività Live";
/* What's New v1.7 - Live Activity, description */
"whatsNew.liveActivity.description" = "I messaggi non letti sono più in evidenza e il tasso di pacchetti al minuto è più facile da capire.";
